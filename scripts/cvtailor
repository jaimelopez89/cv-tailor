#!/bin/bash
# CV Tailor — open as a Mac app.
#
# Starts the local server if it isn't already up, opens it in a standalone
# Chrome window, and stops the server again when that window closes.
#
# Overrides, mostly for the tests in test_launcher.py:
#   CVTAILOR_PORT     port to serve on            (default 8090)
#   CVTAILOR_BROWSER  command to open the window  (default Chrome in app mode)
#   CVTAILOR_UVICORN  server command              (default the venv's uvicorn)
#   CVTAILOR_TIMEOUT  seconds to wait for startup (default 20)
#   CVTAILOR_RAISE    command to reopen a running window (default Chrome again)

set -uo pipefail

# macOS runs script-based .app bundles under Rosetta unless the bundle opts out,
# and the base interpreter is a universal2 binary that inherits our architecture.
# Translated, it loads as x86_64 and cannot open the arm64 wheels in venv. Get
# back to native before anything starts Python.
if [ -z "${CVTAILOR_NATIVE:-}" ] \
   && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ] \
   && [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ]; then
  export CVTAILOR_NATIVE=1
  exec arch -arm64 "$0" "$@"
fi

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR" || exit 1

PORT="${CVTAILOR_PORT:-8090}"
URL="http://127.0.0.1:${PORT}"
TIMEOUT="${CVTAILOR_TIMEOUT:-20}"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_PROFILE="${HOME}/.cv-tailor/chrome"
LOCK="${HOME}/.cv-tailor/instance-${PORT}.pid"

# Launched from Spotlight or the Dock there is no terminal to read, so failures
# have to become something visible.
die() {
  echo "$1" >&2
  if [ -z "${CVTAILOR_BROWSER:-}" ] && command -v osascript >/dev/null 2>&1; then
    osascript -e "display alert \"CV Tailor\" message \"$1\" as critical" >/dev/null 2>&1
  fi
  exit 1
}

# Chrome will not open a second instance on a locked --user-data-dir; it hands
# the URL to the running one and returns immediately, leaving us to kill the
# server we just started. Detect our own instance first and reopen its window.
chrome_window_pid() {
  # The lock only survives a clean exit, so a window orphaned by a force-quit or
  # a closed terminal is invisible to it. Chrome's own processes are not: the
  # helpers carry --user-data-dir too, but only the browser itself has --app.
  local pid args
  for pid in $(pgrep -f -- "--user-data-dir=${CHROME_PROFILE}" 2>/dev/null); do
    args="$(ps -o command= -p "$pid" 2>/dev/null)"
    case "$args" in
      *--type=*) continue ;;
      *--app=*) echo "$pid"; return 0 ;;
    esac
  done
  return 1
}

RUNNING=""
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  RUNNING="$(cat "$LOCK" 2>/dev/null)"
elif [ -z "${CVTAILOR_BROWSER:-}" ]; then
  RUNNING="$(chrome_window_pid || true)"
fi

if [ -n "$RUNNING" ]; then
  # Raising the existing window is not possible: it is a second instance of the
  # user's own Chrome, sharing com.google.Chrome, so it has no Dock icon or
  # Cmd-Tab entry of its own and every "activate the app" call — Apple Events or
  # `open` — resolves to their everyday Chrome. System Events can target our pid
  # but needs Accessibility, which is usually not granted, and `set frontmost`
  # does not un-minimize anyway. Once minimized the window is simply unreachable.
  # Handing the URL to the running instance sidesteps all of it: that opens a
  # fresh window, and a fresh window is never minimized.
  if [ -n "${CVTAILOR_RAISE:-}" ]; then
    # shellcheck disable=SC2086
    eval $CVTAILOR_RAISE
  elif [ -z "${CVTAILOR_BROWSER:-}" ] && [ -x "$CHROME" ]; then
    "$CHROME" \
      --app="$URL" \
      --user-data-dir="$CHROME_PROFILE" \
      --no-first-run \
      --no-default-browser-check \
      --window-size=1440,900 \
      >/dev/null 2>&1
  fi
  echo "CV Tailor: already running — reopening its window."
  exit 0
fi
# Nothing alive behind it, so a leftover lock is stale.
rm -f "$LOCK"

port_is_open() {
  # bash's /dev/tcp needs no extra tooling and is exact about "is anyone there".
  (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") >/dev/null 2>&1
}

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PID=""

if port_is_open; then
  # Something is already serving this port — most likely a dev server started by
  # hand. Use it, but leave it alone on the way out: we only clean up our own.
  echo "CV Tailor: reusing the server already on port ${PORT}"
else
  if [ -n "${CVTAILOR_UVICORN:-}" ]; then
    # shellcheck disable=SC2086
    $CVTAILOR_UVICORN &
  else
    [ -d venv ] && source venv/bin/activate
    # No --reload: the reloader forks a child that survives killing the parent,
    # which would leave the port occupied after every quit.
    python -m uvicorn app:app --port "$PORT" --host 127.0.0.1 \
      >"${TMPDIR:-/tmp}/cv-tailor-server.log" 2>&1 &
  fi
  SERVER_PID=$!

  deadline=$((SECONDS + TIMEOUT))
  until port_is_open; do
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
      die "The CV Tailor server exited on startup. See ${TMPDIR:-/tmp}/cv-tailor-server.log"
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      kill "$SERVER_PID" 2>/dev/null
      die "The CV Tailor server did not start within ${TIMEOUT}s."
    fi
    sleep 0.2
  done
fi

# Killing the window process alone can strand its children — Chrome's helpers,
# or a wrapper shell — so take the whole tree down with it.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null
}

# Stop only a server this script started, however we leave.
cleanup() {
  rm -f "$LOCK"
  # The window is useless without the server and must never outlive it: an
  # orphan shows "refused to connect", and Chrome then hands it the URL of
  # every later launch, which is what made the app impossible to reopen.
  if [ -n "${WINDOW_PID:-}" ] && kill -0 "$WINDOW_PID" 2>/dev/null; then
    kill_tree "$WINDOW_PID"
  fi
  if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null
    wait "$SERVER_PID" 2>/dev/null
  fi
}
trap cleanup EXIT INT TERM

WINDOW_PID=""

# ── Window ───────────────────────────────────────────────────────────────────
mkdir -p "$(dirname "$LOCK")"

if [ -n "${CVTAILOR_BROWSER:-}" ]; then
  # shellcheck disable=SC2086
  eval $CVTAILOR_BROWSER &
  WINDOW_PID=$!
  echo "$WINDOW_PID" > "$LOCK"
  wait "$WINDOW_PID"
elif [ -x "$CHROME" ]; then
  # A dedicated profile is what makes this blocking. Against the default profile
  # Chrome hands the URL to the running Chrome and exits at once, and we would
  # never learn that the window had closed.
  mkdir -p "$CHROME_PROFILE"
  "$CHROME" \
    --app="$URL" \
    --user-data-dir="$CHROME_PROFILE" \
    --no-first-run \
    --no-default-browser-check \
    --window-size=1440,900 \
    >/dev/null 2>&1 &
  WINDOW_PID=$!
  echo "$WINDOW_PID" > "$LOCK"
  wait "$WINDOW_PID"
else
  # No Chrome: fall back to the default browser. It cannot tell us when the tab
  # closes, so hold the server open until this process is stopped.
  open "$URL"
  echo "CV Tailor: Chrome not found — opened in your default browser."
  echo "Press Ctrl+C to stop the server."
  while true; do sleep 3600; done
fi
